{
  "info": {
    "name": "MediRed IPS - ms-pacientes - Taller 3",
    "description": "Pruebas de Pacientes por el API Gateway. Importa y selecciona el entorno MediRed Pacientes Gateway. Ejecuta en orden con una iteración.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token_administrador}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 - Login administrador",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set('token_administrador', '');",
              "const email = pm.environment.get('admin_email') || '';",
              "const password = pm.environment.get('admin_password') || '';",
              "pm.variables.set('pacientesLoginBody', JSON.stringify({ email, password }));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "if (pm.response.code === 200) {",
              "    const { token, usuario } = pm.response.json();",
              "    const rolValido = usuario?.rol === 'administrador';",
              "    pm.test('JWT recibido para administrador', function () {",
              "        pm.expect(token).to.be.a('string').and.not.empty;",
              "        pm.expect(rolValido).to.equal(true);",
              "    });",
              "    if (rolValido && typeof token === 'string' && token) pm.environment.set('token_administrador', token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/usuarios/login",
        "body": {
          "mode": "raw",
          "raw": "{{pacientesLoginBody}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
