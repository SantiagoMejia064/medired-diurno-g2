          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "if (pm.response.code === 201) {",
              "    const paciente = pm.response.json();",
              "    const idValido = Number.isInteger(paciente.id) && paciente.id > 0;",
              "    const documentoCoincide = paciente.documento === pm.collectionVariables.get('documentoPrueba');",
              "    if (idValido && documentoCoincide) pm.collectionVariables.set('pacienteIdPrueba', paciente.id);",
              "    pm.test('Paciente sintético creado', function () {",
              "        pm.expect(idValido && documentoCoincide).to.equal(true);",
              "    });",
              "}"
            ]
          }
        }
