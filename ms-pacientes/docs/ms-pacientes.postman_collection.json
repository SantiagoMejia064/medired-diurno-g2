      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.unset('pacienteIdPrueba');",
              "pm.collectionVariables.set('documentoPrueba', String(9000000000 + Math.floor(Math.random() * 1000000000)));",
              "if (!pm.environment.get('token_administrador')) {",
              "    console.error('Falta token_administrador. Ejecuta las solicitudes anteriores.');",
              "    pm.execution.skipRequest();",
              "}"
            ]
