          ]
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.variables.set('usuariosUrl', String(pm.variables.get('loginUrl')).replace(/\\/usuarios\\/login\\/?$/, ''));",
          "for (const key of ['tokenAdmin', 'tokenMedico', 'tokenAdmisiones']) pm.variables.set(key, pm.collectionVariables.get(key) || '');"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "tokenAdmin",
      "value": "",
      "type": "string"
    },
    {
      "key": "tokenMedico",
      "value": "",
      "type": "string"
    },
    {
      "key": "tokenAdmisiones",
      "value": "",
      "type": "string"
    }
  ]
}
