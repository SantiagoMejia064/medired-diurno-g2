                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Listado parcial con aviso de Médicos\", function () {",
                  "  const historias = pm.response.json();",
                  "  pm.expect(historias).to.be.an('array').that.is.not.empty;",
                  "  pm.expect(historias.every(historia => historia.medico === null && historia.aviso.includes('ms-medicos no está disponible'))).to.be.true;",
                  "  pm.expect(historias.some(historia => historia.paciente !== null)).to.be.true;",
                  "});",
                  "pm.test('La historia preparada está en el listado', () => pm.expect(pm.response.json().some(x => x.id === Number(pm.collectionVariables.get('fallo_id')))).to.equal(true));"
                ]
