                  "});",
                  "pm.test(\"Identificador esperado\", function () {",
                  "  pm.expect(pm.response.json().id).to.equal(Number(pm.collectionVariables.get('persistencia_id')));",
                  "});",
                  "pm.test(\"Motivo actualizado\", function () {",
                  "  pm.expect(pm.response.json().motivo_consulta).to.equal(pm.collectionVariables.get('marca_prueba') + ' persistencia actualizada');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{historias_url}}/historias/{{persistencia_id}}",
            "description": "Ejecuta después del caso 10. Reinicia solo ms-historias, ejecuta este GET y consulta el mismo ID en Workbench. Guarda ambas capturas antes del caso 12."
          },
          "response": []
        },
        {
          "name": "Persistencia - Limpiar verificar registro",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{historias_url}}/historias/{{persistencia_id}}"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset('borrado_verificado');",
                  "const datos = pm.response.json();",
                  "const id = Number(pm.collectionVariables.get('persistencia_id'));",
                  "const valido = pm.response.code === 200 && datos.id === id && String(datos.motivo_consulta).startsWith(pm.collectionVariables.get('marca_prueba') + ' ');",
                  "pm.test('Registro propio antes de eliminar', () => pm.expect(valido).to.equal(true));",
                  "if (valido) pm.collectionVariables.set('borrado_verificado', String(id));",
                  "else pm.execution.setNextRequest(null);"
                ]
              }
            }
          ]
        },
        {
          "name": "Persistencia - Limpiar registro",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{historias_url}}/historias/{{persistencia_id}}"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 204', () => pm.response.to.have.status(204));",
                  "pm.execution.setNextRequest(null);"
                ]
              }
            }
          ]
        }
      ]
    },
