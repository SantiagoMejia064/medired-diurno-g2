{
  "info": {
    "name": "MediRed IPS - Historias - Reinicio y caída",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Pruebas complementarias de Steven. Ejecutar una carpeta por vez: preparar, realizar el cambio real en la terminal y verificar. Cada carpeta detiene el Runner al terminar, para evitar pasar al siguiente paso sin un reinicio o parada real. Usa el mismo entorno que la colección normal. No hay modos ni fases en el entorno."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token_medico}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 - Persistencia preparar",
      "description": "Con todos los servicios activos, ejecutar esta carpeta. Luego reiniciar Historias en terminal.",
      "item": [
        {
          "name": "Acceso - Médico para preparar persistencia",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{usuarios_url}}/usuarios/login",
            "body": {
              "mode": "raw",
              "raw": "{{credenciales_login}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.unset('token_medico');",
                  "const email = pm.variables.get('medico_email');",
                  "const password = pm.variables.get('medico_password');",
                  "if (!email || !password) {",
                  "  pm.test('Credenciales configuradas', () => { throw new Error('Completa medico_email y medico_password en tu entorno local.'); });",
                  "  pm.execution.setNextRequest(null);",
                  "  pm.execution.skipRequest();",
                  "}",
                  "pm.variables.set('credenciales_login', JSON.stringify({email, password}));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "let datos;",
                  "try { datos = pm.response.json(); } catch { datos = {}; }",
                  "const valido = pm.response.code === 200 && typeof datos.token === 'string' && datos.token.length > 0 && datos.usuario?.rol === 'medico';",
                  "pm.test('Token y rol medico', () => pm.expect(valido).to.equal(true));",
                  "if (valido) pm.environment.set('token_medico', datos.token);",
                  "else pm.execution.setNextRequest(null);"
                ]
              }
            }
          ]
        },
        {
          "name": "Preparación - Consultar pacientes para persistencia",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{pacientes_url}}/pacientes"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset('paciente_id');",
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const filas = pm.response.json();",
                  "const valido = pm.response.code === 200 && Array.isArray(filas) && filas.length > 0 && filas.every(x => Number.isInteger(x.id) && x.id > 0);",
                  "pm.test('Proveedor con registros utilizables', () => pm.expect(valido).to.equal(true));",
                  "if (valido) {",
                  "  pm.collectionVariables.set('paciente_id', String(filas[0].id));",
                  "  pm.collectionVariables.set('max_pacientes', String(Math.max(...filas.map(x => x.id))));",
                  "} else pm.execution.setNextRequest(null);"
                ]
              }
            }
          ]
        },
        {
          "name": "Preparación - Consultar medicos para persistencia",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{medicos_url}}/medicos"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset('medico_id');",
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const filas = pm.response.json();",
                  "const valido = pm.response.code === 200 && Array.isArray(filas) && filas.length > 0 && filas.every(x => Number.isInteger(x.id) && x.id > 0);",
                  "pm.test('Proveedor con registros utilizables', () => pm.expect(valido).to.equal(true));",
                  "if (valido) {",
                  "  pm.collectionVariables.set('medico_id', String(filas[0].id));",
                  "  pm.collectionVariables.set('max_medicos', String(Math.max(...filas.map(x => x.id))));",
                  "} else pm.execution.setNextRequest(null);"
                ]
              }
            }
          ]
        },
        {
          "name": "Persistencia - Crear registro",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{historias_url}}/historias",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paciente_id\": {{paciente_id}},\n  \"medico_id\": {{medico_id}},\n  \"fecha\": \"{{fecha_valida}}\",\n  \"motivo_consulta\": \"{{marca_prueba}} persistencia\",\n  \"diagnostico\": \"Diagnóstico ficticio Taller 3\",\n  \"tratamiento\": \"Seguimiento ficticio Taller 3\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set('persistencia_id', String(pm.response.json().id));",
                  "else pm.execution.setNextRequest(null);"
                ]
              }
            }
          ]
        },
        {
          "name": "Persistencia - Actualizar registro",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{historias_url}}/historias/{{persistencia_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paciente_id\": {{paciente_id}},\n  \"medico_id\": {{medico_id}},\n  \"fecha\": \"{{fecha_valida}}\",\n  \"motivo_consulta\": \"{{marca_prueba}} persistencia actualizada\",\n  \"diagnostico\": \"Diagnóstico ficticio Taller 3\",\n  \"tratamiento\": \"Seguimiento ficticio Taller 3\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.execution.setNextRequest(null);"
                ]
              }
            }
          ]
        }
      ]
