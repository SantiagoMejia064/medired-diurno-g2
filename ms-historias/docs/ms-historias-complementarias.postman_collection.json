              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.unset('token_medico');",
                  "const email = pm.variables.get('medico_email');",
                  "const password = pm.variables.get('medico_password');",
                  "if (!email || !password) {",
                  "  pm.test('Credenciales configuradas', () => { throw new Error('Completa medico_email y medico_password en tu entorno local.'); });",
                  "  pm.execution.setNextRequest(null);",
                  "  pm.execution.skipRequest();",
                  "}",
                  "pm.variables.set('credenciales_login', JSON.stringify({email, password}));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "let datos;",
                  "try { datos = pm.response.json(); } catch { datos = {}; }",
                  "const valido = pm.response.code === 200 && typeof datos.token === 'string' && datos.token.length > 0 && datos.usuario?.rol === 'medico';",
                  "pm.test('Token y rol medico', () => pm.expect(valido).to.equal(true));",
                  "if (valido) pm.environment.set('token_medico', datos.token);",
                  "else pm.execution.setNextRequest(null);"
                ]
              }
            }
          ]
        },
        {
          "name": "Fallo - Limpiar verificar registro",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{historias_url}}/historias/{{fallo_id}}"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset('borrado_verificado');",
                  "const datos = pm.response.json();",
                  "const id = Number(pm.collectionVariables.get('fallo_id'));",
                  "const valido = pm.response.code === 200 && datos.id === id && String(datos.motivo_consulta).startsWith(pm.collectionVariables.get('marca_prueba') + ' ');",
                  "pm.test('Registro propio antes de eliminar', () => pm.expect(valido).to.equal(true));",
                  "if (valido) pm.collectionVariables.set('borrado_verificado', String(id));",
                  "else pm.execution.setNextRequest(null);",
                  "pm.test('Médicos nuevamente disponible', () => pm.expect(pm.response.json().medico !== null && !pm.response.json().aviso).to.equal(true));",
                  "if (pm.response.json().medico === null || pm.response.json().aviso) { pm.collectionVariables.unset('borrado_verificado'); pm.execution.setNextRequest(null); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Fallo - Limpiar registro",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{historias_url}}/historias/{{fallo_id}}"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 204', () => pm.response.to.have.status(204));",
                  "pm.execution.setNextRequest(null);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "90 - Limpieza de registros propios",
      "item": [
        {
          "name": "90 - Consultar registro propio antes de borrar",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{historias_url}}/historias/{{limpieza_id}}"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const id = Number(pm.variables.get('limpieza_id'));",
                  "pm.collectionVariables.unset('borrado_verificado');",
                  "if (pm.response.code === 404) {",
                  "  pm.test('Registro propio ya eliminado', () => pm.response.to.have.status(404));",
                  "  const ids = JSON.parse(pm.collectionVariables.get('ids_propios') || '[]').filter(x => x !== id);",
                  "  pm.collectionVariables.set('ids_propios', JSON.stringify(ids));",
                  "  pm.execution.setNextRequest(ids.length ? pm.info.requestId : null);",
                  "} else {",
                  "  const datos = pm.response.json();",
                  "  const valido = pm.response.code === 200 && datos.id === id && String(datos.motivo_consulta).startsWith(pm.collectionVariables.get('marca_prueba') + ' ');",
                  "  pm.test('Identidad y marca del registro propio', () => pm.expect(valido).to.equal(true));",
                  "  if (valido) pm.collectionVariables.set('borrado_verificado', String(id));",
                  "  else pm.execution.setNextRequest(null);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "91 - Eliminar registro propio verificado",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{historias_url}}/historias/{{limpieza_id}}"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 204 y cuerpo vacío', () => {",
                  "  pm.response.to.have.status(204);",
                  "  pm.expect(pm.response.text()).to.equal('');",
                  "});",
                  "if (pm.response.code === 204 && JSON.parse(pm.collectionVariables.get('ids_propios') || '[]').length) pm.execution.setNextRequest('90 - Consultar registro propio antes de borrar');",
                  "else pm.execution.setNextRequest(null);"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
