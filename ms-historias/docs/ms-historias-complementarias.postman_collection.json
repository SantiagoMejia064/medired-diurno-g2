  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// token_admisiones: se guarda automáticamente en el entorno seleccionado.",
          "// token_medico: se guarda automáticamente en el entorno seleccionado.",
          "// token_administrador: se guarda automáticamente en el entorno seleccionado.",
          "// Los valores calculados pertenecen a esta colección, no a IDs de otro entorno.",
          "const calculadas = ['admin_historia_id','paciente_id','medico_id','id_inexistente','historia_existente_id','caso_07_id','caso_19_id','persistencia_id','fallo_id','marca_prueba','origen_prueba','ids_propios','borrado_verificado'];",
          "calculadas.forEach(k => pm.variables.set(k, pm.collectionVariables.get(k) || ''));",
          "['token_administrador','token_medico','token_admisiones'].forEach(k => pm.variables.set(k, pm.environment.get(k) || ''));",
          "// La fecha se calcula dentro del script; no requiere configuración.",
          "pm.variables.set('fecha_valida', new Date(Date.now() - 86400000).toISOString().slice(0,10));",
          "const nombre = pm.info.requestName;",
          "const login = nombre.startsWith('Acceso -');",
          "const manualP = nombre.startsWith('Persistencia -');",
          "const manualM = nombre.startsWith('Fallo -') || nombre.startsWith('23 -') || nombre.startsWith('24 -');",
          "const limpieza = nombre.startsWith('90 -') || nombre.startsWith('91 -');",
          "function bloquear(mensaje) {",
          "  pm.test('Preparación requerida', () => { throw new Error(mensaje); });",
          "  pm.execution.setNextRequest(null);",
          "  pm.execution.skipRequest();",
          "}",
          "if (nombre === 'Estado del servicio' && !pm.variables.get('health_url')) pm.execution.skipRequest();",
          "const ids = JSON.parse(pm.collectionVariables.get('ids_propios') || '[]');",
          "const origen = String(pm.variables.get('historias_url')).replace(/\\/$/, '');",
          "if (ids.length && pm.collectionVariables.get('origen_prueba') !== origen) bloquear('Hay registros pendientes de otro origen. Usa el entorno anterior y ejecuta limpieza antes de cambiar URL.');",
          "if (!login && nombre !== 'Estado del servicio' && !pm.environment.get('token_medico')) bloquear('Ejecuta primero Acceso - Médico.');",
          "if ((nombre.startsWith('16 -') || nombre.startsWith('17 -')) && !pm.environment.get('token_admisiones')) bloquear('Ejecuta primero Acceso - Admisiones.');",
          "if (nombre.startsWith('Admin -') && !pm.environment.get('token_administrador')) bloquear('Ejecuta primero Acceso - Administrador.');",
          "if (limpieza) {",
          "  if (!ids.length) pm.execution.skipRequest();",
          "  pm.variables.set('limpieza_id', String(ids[ids.length-1]));",
          "  if (nombre.startsWith('91 -') && pm.collectionVariables.get('borrado_verificado') !== String(ids[ids.length-1])) bloquear('Ejecuta primero 90 - Consultar registro propio antes de borrar.');",
          "}",
          "if (nombre === 'Preparación - Crear historia base') {",
          "  if (ids.length) bloquear('Quedaron registros de una ejecución anterior. Ejecuta la carpeta 90 - Limpieza y vuelve a comenzar.');",
          "}",
          "if (nombre === 'Preparación - Crear historia base' || nombre === 'Persistencia - Crear registro' || nombre === 'Fallo - Crear registro') {",
          "  if (nombre !== 'Preparación - Crear historia base' && ids.length) bloquear('Limpia la ejecución anterior antes de preparar la prueba manual.');",
          "  if (!pm.collectionVariables.get('paciente_id') || !pm.collectionVariables.get('medico_id')) bloquear('Ejecuta la preparación de pacientes y médicos con ambos proveedores activos.');",
          "  const marca = 'T3-Steven-' + Date.now() + '-' + Math.random().toString(16).slice(2,8);",
          "  pm.collectionVariables.set('marca_prueba', marca);",
          "  pm.variables.set('marca_prueba', marca);",
          "  pm.collectionVariables.set('origen_prueba', origen);",
          "}",
          "// Evita actuar sobre IDs suministrados a mano en un entorno.",
          "let destino = '';",
          "if (nombre.startsWith('10 -') || nombre.startsWith('12 -')) destino = pm.collectionVariables.get('caso_07_id');",
          "if (nombre.startsWith('Persistencia -') && nombre !== 'Persistencia - Crear registro') destino = pm.collectionVariables.get('persistencia_id');",
          "if (nombre.startsWith('Fallo - Limpiar')) destino = pm.collectionVariables.get('fallo_id');",
          "if (nombre.startsWith('Admin -') && pm.request.method !== 'POST') {",
          "  destino = pm.collectionVariables.get('admin_historia_id');",
          "  if (!destino) bloquear('Ejecuta primero Admin - Crear historia.');",
          "}",
          "if (destino && !ids.includes(Number(destino))) bloquear('El ID no pertenece a registros creados por esta ejecución.');",
          "if ((manualP || manualM) && pm.request.method === 'DELETE' && pm.collectionVariables.get('borrado_verificado') !== String(destino)) bloquear('Ejecuta primero la verificación de limpieza de esta prueba manual.');",
          "if ((nombre.startsWith('10 -') || nombre.startsWith('12 -') || (manualP && nombre !== 'Persistencia - Crear registro') || nombre.startsWith('Fallo - Limpiar')) && !destino) bloquear('Falta crear el registro de prueba correspondiente.');"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Conserva IDs creados incluso si un caso negativo respondiera 201 por error.",
          "if (pm.request.method === 'POST' && !pm.info.requestName.startsWith('Acceso -') && pm.response.code === 201) {",
          "  const nuevo = pm.response.json();",
          "  if (Number.isInteger(nuevo.id) && nuevo.id > 0) {",
          "    const ids = JSON.parse(pm.collectionVariables.get('ids_propios') || '[]');",
          "    if (!ids.includes(nuevo.id)) ids.push(nuevo.id);",
          "    pm.collectionVariables.set('ids_propios', JSON.stringify(ids));",
          "  }",
          "}",
          "if (pm.request.method === 'DELETE' && pm.response.code === 204) {",
          "  const url = pm.variables.replaceIn(pm.request.url.toString());",
          "  const id = Number(url.split('/').pop());",
          "  const ids = JSON.parse(pm.collectionVariables.get('ids_propios') || '[]');",
          "  pm.collectionVariables.set('ids_propios', JSON.stringify(ids.filter(x => x !== id)));",
          "  pm.collectionVariables.unset('borrado_verificado');",
          "}"
        ]
      }
    }
  ]
