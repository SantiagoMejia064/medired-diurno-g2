    {
      "name": "03 - Relaciones y caída",
      "description": "Captura los casos 19 a 24. Para 22 registra el tráfico en las terminales. Para 23 y 24 detén solo Médicos y vuelve a iniciarlo al finalizar.",
      "item": [
        {
          "name": "19 - Crear con paciente y médico válidos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Identificador y cabecera Location\", function () {",
                  "  const id = pm.response.json().id;",
                  "  pm.expect(id).to.be.a('number').and.above(0);",
                  "  pm.expect(pm.response.headers.get('Location')).to.equal('/historias/' + id);",
                  "});",
                  "pm.test(\"Paciente y médico relacionados\", function () {",
                  "  const historia = pm.response.json();",
                  "  pm.expect(historia.paciente.id).to.equal(historia.paciente_id);",
                  "  pm.expect(historia.paciente.nombre).to.be.a('string');",
                  "  pm.expect(historia.medico.id).to.equal(historia.medico_id);",
                  "  pm.expect(historia.medico.nombre).to.be.a('string');",
                  "  pm.expect(historia.medico.especialidad).to.be.a('string');",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  const id = pm.response.json().id;",
                  "  if (Number.isInteger(id) && id > 0) {",
                  "    pm.environment.set('caso_19_id', String(id));",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
