              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"La respuesta es un arreglo\", function () {",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{historias_url}}/historias",
            "description": "Devuelve el listado."
          },
          "response": []
