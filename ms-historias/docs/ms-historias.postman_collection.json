{
  "info": {
    "name": "ms-historias",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "MediRed IPS · Taller 2. Ejecuta primero los inicios de sesión de Médico y Admisiones en ms-usuarios — Acceso para Historias con MediRed local seleccionado. Caso 03 no aplica. Los casos 23 y 24 requieren detener solo Médicos. Usa datos ficticios en el entorno local."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token_medico}}",
        "type": "string"
      }
    ]
  },
