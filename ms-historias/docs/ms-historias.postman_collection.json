    {
      "name": "00 - Estado del servicio",
      "item": [
        {
          "name": "Estado del servicio",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Servicio y estado\", function () {",
                  "  const estado = pm.response.json();",
                  "  pm.expect(estado.servicio).to.equal('ms-historias');",
                  "  pm.expect(estado.estado).to.equal('ok');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{historias_url}}/health",
            "description": "Comprueba que Historias responde.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        }
      ]
    },
