          "name": "02 - Filtrar por paciente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"El filtro coincide con el paciente\", function () {",
                  "  const historias = pm.response.json();",
                  "  const id = Number(pm.environment.get('paciente_id'));",
                  "  pm.expect(historias).to.be.an('array').that.is.not.empty;",
                  "  pm.expect(historias.every(historia => historia.paciente_id === id)).to.be.true;",
                  "});"
